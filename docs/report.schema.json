{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Changeproof local analysis report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "5.0.0"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "changeproof"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "compared_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparison": {
      "enum": [
        "HEAD_to_tracked_working_tree",
        "current_files"
      ]
    },
    "runtime_verification": {
      "const": false
    },
    "analysis_complete": {
      "type": "boolean"
    },
    "files_inspected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "untracked_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "excluded": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "review_status": {
            "enum": [
              "included",
              "skipped",
              "not_analyzed"
            ]
          }
        },
        "required": [
          "file",
          "excluded",
          "reason"
        ]
      }
    },
    "skipped_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "reason"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "analysis_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "file",
          "message"
        ]
      }
    },
    "default_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "const": "CP002"
          },
          "code": {
            "type": "string"
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "message": {
            "type": "string"
          },
          "revision": {
            "enum": [
              "HEAD",
              "working_tree",
              "current_files"
            ]
          }
        },
        "required": [
          "rule_id",
          "code",
          "location",
          "message",
          "revision"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "analyzed",
            "partial",
            "unsupported",
            "not_analyzed"
          ]
        },
        "scope": {
          "type": "string"
        },
        "analyzed_scopes": {
          "type": "integer",
          "minimum": 0
        },
        "partial_scopes": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_scopes": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed_files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "scope",
        "analyzed_scopes",
        "partial_scopes",
        "unsupported_scopes",
        "unassessed_files"
      ]
    },
    "review_mode": {
      "enum": [
        "current",
        "changes"
      ]
    },
    "git_repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "assessed",
            "partial",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "Checkov"
            },
            "version": {
              "const": "3.4.5"
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "framework": {
                "enum": [
                  "terraform",
                  "kubernetes",
                  "dockerfile",
                  "github_actions"
                ]
              },
              "files": {
                "type": "integer",
                "minimum": 0
              },
              "checks": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "not_assessed",
                  "assessed",
                  "partial",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "framework",
              "files",
              "checks",
              "failed",
              "skipped",
              "status"
            ]
          }
        },
        "files_inspected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "snapshot": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "snapshot"
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "skipped_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "reason"
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "boolean"
            },
            "network": {
              "type": "integer",
              "minimum": 0
            },
            "subprocess": {
              "type": "integer",
              "minimum": 0
            },
            "outside_read": {
              "type": "integer",
              "minimum": 0
            },
            "outside_write": {
              "type": "integer",
              "minimum": 0
            },
            "metadata_probes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "active",
            "network",
            "subprocess",
            "outside_read",
            "outside_write",
            "metadata_probes"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "reason",
        "scanner",
        "frameworks",
        "files_inspected",
        "findings",
        "skipped_files",
        "errors",
        "guard",
        "limitations"
      ]
    },
    "container_images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "assessed",
            "partial",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "Trivy"
            },
            "source": {
              "const": "local Docker images"
            },
            "database": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "source",
            "database"
          ]
        },
        "files_inspected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "snapshot": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "snapshot"
            ]
          }
        },
        "images": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "image": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "not_assessed",
                  "assessed"
                ]
              },
              "high_critical_findings": {
                "type": "integer",
                "minimum": 0
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "file",
                    "line"
                  ]
                }
              }
            },
            "required": [
              "image",
              "status",
              "high_critical_findings",
              "references"
            ]
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "line",
              "reason"
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "reason",
        "scanner",
        "files_inspected",
        "images",
        "findings",
        "skipped",
        "errors",
        "limitations"
      ]
    }
  },
  "required": [
    "schema_version",
    "tool",
    "repository",
    "compared_revision",
    "comparison",
    "runtime_verification",
    "analysis_complete",
    "files_inspected",
    "untracked_files",
    "skipped_files",
    "findings",
    "analysis_errors",
    "default_exclusions",
    "limitations",
    "analysis_limitations",
    "coverage",
    "review_mode",
    "git_repository",
    "input_limitations",
    "infrastructure"
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "line",
        "column"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "old_start": {
          "type": "integer",
          "minimum": 1
        },
        "old_count": {
          "type": "integer",
          "minimum": 0
        },
        "new_start": {
          "type": "integer",
          "minimum": 1
        },
        "new_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "old_start",
        "old_count",
        "new_start",
        "new_count"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "unchanged",
            "current"
          ]
        },
        "changed_line_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "analyzed",
                "partial",
                "unsupported",
                "not_analyzed"
              ]
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "function",
                      "top_level"
                    ]
                  },
                  "location": {
                    "$ref": "#/$defs/location"
                  },
                  "status": {
                    "enum": [
                      "analyzed",
                      "partial",
                      "unsupported"
                    ]
                  },
                  "supported_steps": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "location",
                  "status",
                  "supported_steps"
                ]
              }
            }
          },
          "required": [
            "status",
            "scopes"
          ]
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file",
        "status",
        "changed_line_ranges",
        "coverage"
      ]
    },
    "finding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule_id": {
              "const": "CP001"
            },
            "title": {
              "const": "Potential sensitive logging"
            },
            "severity": {
              "const": "warning"
            },
            "explanation": {
              "type": "string"
            },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "start": {
                  "$ref": "#/$defs/position"
                },
                "end": {
                  "$ref": "#/$defs/position"
                }
              },
              "required": [
                "file",
                "start",
                "end"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "syntax"
                },
                "console_method": {
                  "enum": [
                    "log",
                    "info",
                    "warn",
                    "error",
                    "debug",
                    "trace"
                  ]
                },
                "sensitive_names": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "accesstoken",
                      "refreshtoken",
                      "password",
                      "authorization"
                    ]
                  }
                },
                "source_values_included": {
                  "const": false
                }
              },
              "required": [
                "kind",
                "console_method",
                "sensitive_names",
                "source_values_included"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "newly_introduced": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "runtime_verification": {
              "const": false
            }
          },
          "required": [
            "rule_id",
            "title",
            "severity",
            "explanation",
            "location",
            "evidence",
            "limitations",
            "newly_introduced",
            "runtime_verification"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule_id": {
              "const": "CP002"
            },
            "title": {
              "const": "Potential authorization-header logging"
            },
            "severity": {
              "const": "warning"
            },
            "explanation": {
              "type": "string"
            },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "start": {
                  "$ref": "#/$defs/position"
                },
                "end": {
                  "$ref": "#/$defs/position"
                }
              },
              "required": [
                "file",
                "start",
                "end"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "bounded_same_file_data_flow"
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "authorization_header_read"
                          },
                          "location": {
                            "$ref": "#/$defs/location"
                          }
                        },
                        "required": [
                          "kind",
                          "location"
                        ]
                      },
                      "assignments": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "enum": [
                                "declaration",
                                "assignment"
                              ]
                            },
                            "variable": {
                              "type": "string"
                            },
                            "location": {
                              "$ref": "#/$defs/location"
                            }
                          },
                          "required": [
                            "kind",
                            "variable",
                            "location"
                          ]
                        }
                      },
                      "logging": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "console_method": {
                            "enum": [
                              "log",
                              "info",
                              "warn",
                              "error",
                              "debug",
                              "trace"
                            ]
                          },
                          "argument_index": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "location": {
                            "$ref": "#/$defs/location"
                          }
                        },
                        "required": [
                          "console_method",
                          "argument_index",
                          "location"
                        ]
                      },
                      "newly_introduced": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "comparison": {
                        "enum": [
                          "matched_in_HEAD",
                          "not_matched_in_HEAD",
                          "unknown_baseline_limitations",
                          "unknown_function_identity",
                          "not_applicable_current_files"
                        ]
                      },
                      "trace": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "enum": [
                                "source",
                                "assignment",
                                "argument",
                                "function_call",
                                "parameter",
                                "logging"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "location": {
                              "$ref": "#/$defs/location"
                            },
                            "variable": {
                              "type": "string"
                            },
                            "function_name": {
                              "type": "string"
                            },
                            "argument_index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "kind",
                            "label",
                            "location"
                          ]
                        }
                      }
                    },
                    "required": [
                      "source",
                      "assignments",
                      "logging",
                      "newly_introduced",
                      "comparison"
                    ]
                  }
                },
                "source_values_included": {
                  "const": false
                },
                "related_rules": {
                  "type": "array",
                  "items": {
                    "const": "CP001"
                  }
                },
                "sensitive_names": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "accesstoken",
                      "refreshtoken",
                      "password",
                      "authorization"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "paths",
                "source_values_included"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "newly_introduced": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "runtime_verification": {
              "const": false
            }
          },
          "required": [
            "rule_id",
            "title",
            "severity",
            "explanation",
            "location",
            "evidence",
            "limitations",
            "newly_introduced",
            "runtime_verification"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule_id": {
              "enum": [
                "CP003",
                "CP004"
              ]
            },
            "title": {
              "type": "string"
            },
            "severity": {
              "const": "warning"
            },
            "explanation": {
              "type": "string"
            },
            "location": {
              "$ref": "#/$defs/location"
            },
            "newly_introduced": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "runtime_verification": {
              "const": false
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "risky_syntax"
                },
                "pattern": {
                  "enum": [
                    "direct_eval",
                    "function_constructor",
                    "node_tls_environment_disabled",
                    "https_certificate_verification_disabled"
                  ]
                },
                "source_values_included": {
                  "const": false
                }
              },
              "required": [
                "kind",
                "pattern",
                "source_values_included"
              ]
            }
