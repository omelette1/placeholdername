{
  "name": "changeproof-local",
  "version": "0.9.0",
  "private": true,
  "description": "Initial local static-analysis prototype for reviewing code changes",
  "type": "module",
  "bin": {
    "changeproof": "packages/engine/src/cli.mjs"
  },
  "scripts": {
    "review": "node packages/engine/src/cli.mjs",
    "test": "node --import ./evaluation/test/local-network-only.mjs --test packages/engine/test/*.test.mjs packages/ai/test/*.test.mjs services/review-api/test/*.test.mjs evaluation/test/*.test.mjs extensions/vscode/test/*.test.cjs",
    "build:extension": "node extensions/vscode/build.mjs",
    "package:extension": "npm run build:extension && node extensions/vscode/package.mjs",
    "start:review-api": "node --env-file=services/review-api/.env services/review-api/src/start.mjs",
    "build:review-api": "node scripts/build-review-api.mjs",
    "evaluate:ai": "node evaluation/run.mjs",
    "check:ai": "node evaluation/smoke.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "diff": "8.0.4",
    "fastify": "^5.12.8",
    "ignore": "7.0.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
