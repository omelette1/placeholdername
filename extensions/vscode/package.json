{
  "name": "changeproof-local",
  "displayName": "Changeproof Local Review",
  "description": "Local static checks and opt-in AI assessment with explicit patch proposals; no runtime verification.",
  "version": "0.17.0",
  "publisher": "changeproof-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./src/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:changeproof.reviewLocalChanges",
    "onView:changeproof.findings",
    "onCommand:changeproof.runDemo",
    "onCommand:changeproof.reviewProject",
    "onCommand:changeproof.aiReviewChanges",
    "onCommand:changeproof.checkAiConnection",
    "onView:changeproof.controls"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "changeproof.reviewProject",
        "title": "Review Project",
        "category": "Changeproof",
        "icon": "$(shield)"
      },
      {
        "command": "changeproof.runDemo",
        "title": "Run Demo",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.reviewLocalChanges",
        "title": "Review Local Changes",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.showReviewDetails",
        "title": "Show Review Details",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.selectFolderToReview",
        "title": "Select Folder to Review",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.rerunReview",
        "title": "Rerun Reviewed Folder",
        "category": "Changeproof",
        "icon": "$(refresh)"
      },
      {
        "command": "changeproof.aiReviewChanges",
        "title": "AI Review Changes",
        "category": "Changeproof",
        "icon": "$(sparkle)"
      },
      {
        "command": "changeproof.setAiAccessToken",
        "title": "Set AI Review Access Token",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.checkAiConnection",
        "title": "Check AI Connection",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.refreshAiStatus",
        "title": "Refresh AI Status",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.showAiSetup",
        "title": "AI Setup Guide",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.openDashboard",
        "title": "Open Review Dashboard",
        "category": "Changeproof",
        "icon": "$(layout)"
      },
      {
        "command": "changeproof.openControls",
        "title": "Open Changeproof",
        "category": "Changeproof"
      },
      {
        "command": "changeproof.checkClaims",
        "title": "Check Assistant Claims",
        "category": "Changeproof"
      }
    ],
    "views": {
      "changeproof": [
        {
          "id": "changeproof.controls",
          "name": "Scan",
          "type": "webview"
        },
        {
          "id": "changeproof.findings",
          "name": "Results",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Changeproof",
      "properties": {
        "changeproof.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to a trusted Node.js 20.19+ executable. Empty uses Node from the extension host PATH. Never select a project-provided executable."
        },
        "changeproof.aiBackendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4318",
          "scope": "application",
          "description": "User-level AI review backend origin. HTTPS required except loopback development. Workspace settings are ignored. Source is sent only after preview approval."
        },
        "changeproof.checkovPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "User-level absolute path to trusted Checkov 3.4.5 outside reviewed projects. Empty searches the extension host PATH. No installation during reviews."
        },
        "changeproof.aiProfile": {
          "type": "string",
          "enum": [
            "demo",
            "full"
          ],
          "default": "demo",
          "scope": "application",
          "description": "Explicit AI context/generation profile. Demo uses smaller contexts and a 3000 completion-token cap; estimates do not guarantee provider quota availability."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "changeproof.openDashboard",
          "when": "view == changeproof.findings",
          "group": "navigation@0"
        },
        {
          "command": "changeproof.rerunReview",
          "when": "view == changeproof.findings",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "changeproof",
          "title": "Changeproof",
          "icon": "media/activity.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
