{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Changeproof AI response 1.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "request_id": {
      "type": "string",
      "maxLength": 32
    },
    "baseline": {
      "type": "string",
      "maxLength": 64
    },
    "provider": {
      "enum": [
        "groq",
        "mock"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 200
    },
    "runtime_verification": {
      "const": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "assessed",
            "insufficient_context"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "sensitive_data_exposure",
                  "weakened_access_check"
                ]
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "explanation": {
                "type": "string",
                "maxLength": 2000
              },
              "potential_impact": {
                "type": "string",
                "maxLength": 2000
              },
              "reasoning": {
                "type": "string",
                "maxLength": 2000
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 600
                },
                "maxItems": 12
              },
              "missing_context": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 600
                },
                "maxItems": 12
              },
              "suggested_verification": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 600
                },
                "maxItems": 12
              },
              "suggested_correction": {
                "type": "string",
                "maxLength": 2000
              },
              "suggested_edits": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "revision_id": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "expected": {
                      "type": "string",
                      "maxLength": 6000
                    },
                    "replacement": {
                      "type": "string",
                      "maxLength": 6000
                    }
                  },
                  "required": [
                    "file",
                    "revision_id",
                    "start_line",
                    "end_line",
                    "expected",
                    "replacement"
                  ],
                  "additionalProperties": false
                }
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "revision": {
                      "enum": [
                        "before",
                        "after"
                      ]
                    },
                    "revision_id": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "file",
                    "revision",
                    "revision_id",
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 12,
                "minItems": 1
              }
            },
            "required": [
              "category",
              "title",
              "explanation",
              "potential_impact",
              "reasoning",
              "assumptions",
              "missing_context",
              "suggested_verification",
              "suggested_correction",
              "suggested_edits",
              "references"
            ],
            "additionalProperties": false
          },
          "maxItems": 12
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 600
          },
          "maxItems": 30
        },
        "context_requests": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 600
          },
          "maxItems": 12
        }
      },
      "required": [
        "status",
        "summary",
        "findings",
        "limitations",
        "context_requests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "baseline",
    "provider",
    "model",
    "runtime_verification",
    "assessment"
  ],
  "additionalProperties": false
}
