{
  "name": "changeproof-local",
  "version": "0.7.0",
  "private": true,
  "description": "Initial local static-analysis prototype for reviewing code changes",
  "type": "module",
  "bin": {
    "changeproof": "packages/engine/src/cli.mjs"
  },
  "scripts": {
    "review": "node packages/engine/src/cli.mjs",
    "test": "node --test packages/engine/test/*.test.mjs extensions/vscode/test/*.test.cjs",
    "build:extension": "node extensions/vscode/build.mjs",
    "package:extension": "npm run build:extension && node extensions/vscode/package.mjs"
  },
  "dependencies": {
    "diff": "8.0.4",
    "ignore": "7.0.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1",
    "ajv": "8.20.0",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
